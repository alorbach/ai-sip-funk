# SIPFunk – Beispielkonfiguration (English: .env.example)
#
# Nach .env kopieren und Werte eintragen. Die .env enthält Zugangsdaten: nie committen, nie weitergeben.
# Zum Starten ist nichts Pflicht: Ohne SIP_USER und SIP_PASSWORD öffnet die Web-UI den Einrichtungsassistenten;
# er fragt danach und nach OPENAI_API_KEY, prüft die Werte und schreibt sie in diese Datei.
# Änderungen wirken erst nach einem Neustart.
#
# Viele Werte sind nur STARTWERTE: Sie lassen sich in der Web-UI ändern und liegen dann in settings.json,
# die Vorrang vor dieser Datei hat. Solche Variablen sind mit [UI] markiert.
# Schalter so schreiben wie im jeweiligen Beispiel (true/false bzw. on/off); 1 und ja gelten überall als „an“.

# ---------------------------------------------------------------------------
# Telefonanlage (FRITZ!Box: Telefonie → Telefoniegeräte → LAN/WLAN (IP-Telefon))
# ---------------------------------------------------------------------------
# Adresse der Box; dient auch als SIP-Domain
SIP_SERVER=fritz.box
# Benutzername und Kennwort der IP-Telefon-Nebenstelle
SIP_USER=
SIP_PASSWORD=
# Lokaler UDP-Port für SIP (nicht 5060, um Konflikte mit anderen Softphones zu vermeiden)
SIP_LOCAL_PORT=5062
# Lokaler UDP-Port für das Audio (RTP)
RTP_PORT=40000
# Lokale IP-Adresse dieses Rechners im LAN, z. B. 192.0.2.20; leer = automatisch ermitteln
LOCAL_IP=
# HD-Audio: G.711 mit 16 kHz aushandeln; false = nur klassisches 8 kHz (zur Gegenprobe bei Tonproblemen)
AUDIO_HD=true
# 1 = alle SIP-Nachrichten ins Log schreiben (enthält Rufnummern)
SIP_DEBUG=0

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# API-Schlüssel mit Zugriff auf die Realtime-Modelle; leer = nur Testton und Echo
OPENAI_API_KEY=
# [UI] Sprachmodell (Realtime): gpt-realtime-2.1 oder gpt-realtime-2.1-mini
OPENAI_MODEL=gpt-realtime-2.1
# [UI] Textmodell für Gesprächsplan, Zusammenfassung, Einschätzung und Beschwerde-Entwurf
OPENAI_SUMMARY_MODEL=gpt-6-luna

# ---------------------------------------------------------------------------
# Betrieb
# ---------------------------------------------------------------------------
# Port der Web-UI (nur an 127.0.0.1 gebunden)
WEB_PORT=8080
# Mithören im Browser (nur live, keine Aufzeichnung)
LIVE_LISTEN_ENABLED=true
# Eigene Rufnummer(n), mit Komma getrennt, z. B. 0171 3920000. Ziel des Rückrufs bei wichtigen Anrufen;
# dort meldet sich die KI persönlich ohne KI-Erklärung. Alternative: ein Kontakt mit Kennzeichen „Inhaber“.
OWNER_NUMBERS=
# [UI] Hartes Gesprächslimit in Sekunden
MAX_CALL_SECONDS=300
# [UI] Gesprächsprotokolle nach so vielen Tagen löschen
TRANSCRIPT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# KI-Assistent und Anrufformular [UI]
# ---------------------------------------------------------------------------
# Name, mit dem sich die KI vorstellt
AI_NAME=Alex
# In wessen Auftrag sie spricht (dein Name oder der deiner Firma), z. B. Max Mustermann
AI_PRINCIPAL=
# Stil: Dateiname aus personas/ ohne Nummer und Endung (professionell, locker, formell, herzlich)
AI_PERSONA=professionell
# Stimme: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
AI_VOICE=marin
# Anrede: sie oder du
AI_ADDRESS=sie
# Zusätzliche Hinweise zum Verhalten (Freitext)
AI_EXTRA=
# Vorbelegter Auftrag für ausgehende Anrufe
AI_TASK=
# Vorbelegter Audio-Modus: ai (KI-Gespräch), tone (Testton) oder echo
AI_DEFAULT_MODE=ai

# ---------------------------------------------------------------------------
# Gesprächsverhalten [UI: Einstellungen › Technik]
# ---------------------------------------------------------------------------
# Sprechgeschwindigkeit der KI (0.25–1.5, 1 = normal)
AI_SPEECH_SPEED=1.05
# Verstärkung der KI-Stimme Richtung Telefon (1 = unverändert)
AI_OUTPUT_GAIN=1.5
# Darf das Gegenüber die KI unterbrechen?
AI_ALLOW_INTERRUPT=true
# Stille in ms, nach der ein Satzende angenommen wird (höher = weniger Hineinreden in Denkpausen)
AI_VAD_SILENCE_MS=900
# Schwelle der Spracherkennung (0.3–0.9): höher = Geräusche unterbrechen die KI seltener
AI_VAD_THRESHOLD=0.6
# Ausgehend: so lange in ms auf das Gegenüber warten, bevor die KI von sich aus grüßt
AI_GREETING_WAIT_MS=2500
# Nachhörphase in ms nach der Verabschiedung: sagt das Gegenüber noch etwas, geht das Gespräch weiter
AI_HANGUP_GRACE_MS=2000
# Stillstandswächter: bleibt es nach der KI-Ausgabe so lange (ms) still, wird die KI angestoßen (0 = aus)
AI_STALL_MS=6000

# ---------------------------------------------------------------------------
# Anrufbeantworter [UI]
# ---------------------------------------------------------------------------
# Eingehende Anrufe von der KI annehmen lassen
INCOMING_ENABLED=off
# Annahme beim n-ten Klingeln (1 = sofort)
INCOMING_ANSWER_AFTER_RINGS=5
# Auftrag bei eingehenden Anrufen; leer = Anliegen und Rückrufwunsch aufnehmen
INCOMING_TASK=
# Veraltet, wird nur noch übernommen: Meldung je eigener Rufnummer als „Endziffern = Name“, mehrere mit ; getrennt,
# z. B. 23125100 = Max Mustermann; 23125200 = Mustermann IT-Service. Besser: Profile in der Web-UI anlegen.
INCOMING_IDENTITIES=

# ---------------------------------------------------------------------------
# Benachrichtigungen nach einem angenommenen Anruf [UI]
# ---------------------------------------------------------------------------
# Hinweis im Tray (nur Tray-App)
NOTIFY_TRAY=on
# E-Mail mit Zusammenfassung (braucht den E-Mail-Versand unten)
NOTIFY_EMAIL=on
# Bei wichtigen Anrufen den Inhaber anrufen (braucht OWNER_NUMBERS oder einen Inhaber-Kontakt)
NOTIFY_CALL=on
# Pop-up der Tray-App, solange ein Anruf klingelt
RING_POPUP=on

# ---------------------------------------------------------------------------
# Spam-Abwehr [UI]
# ---------------------------------------------------------------------------
# Der Modus selbst lässt sich NUR in der Web-UI einschalten, nach Bestätigung des Risikos (doc/legal.de.md).
# Bekannte Spam-Nummern oder Vorwahlen, mit ; getrennt; „anonym“ = unterdrückte Nummern
SCAM_NUMBERS=
# Unbekannte Anrufernummern beim Klingeln bei tellows.de nachschlagen; überträgt die Nummer dorthin
SPAM_LOOKUP=off

# ---------------------------------------------------------------------------
# E-Mail-Versand [UI: Einstellungen › E-Mail-Versand, dort auch „Automatisch einrichten“]
# ---------------------------------------------------------------------------
# Versandweg: smtp (Passwort) | gmail (OAuth) | m365 (Microsoft 365, OAuth)
MAIL_PROVIDER=smtp
# Empfänger der Benachrichtigungen, z. B. max@example.com; leer = das Postfach selbst
NOTIFY_EMAIL_TO=
# Absender; leer = das Postfach
MAIL_FROM=

# --- smtp ---
# Server, z. B. smtp.example.com; leer = kein Versand
SMTP_HOST=
SMTP_PORT=587
# true = SSL/TLS (meist Port 465), false = STARTTLS (meist Port 587)
SMTP_SECURE=false
SMTP_USER=
# Bei vielen Anbietern ein App-Passwort, nicht das Kontopasswort
SMTP_PASS=

# --- gmail / m365 ---
# OAuth-Client; die Anmeldung erfolgt einmalig über „Mail-Konto verbinden“ in der Web-UI.
# Gmail: Google Cloud Console → OAuth-Client vom Typ „Desktop-App“.
# Microsoft 365: Entra-App-Registrierung, Plattform „Mobile- und Desktopanwendungen“,
#   Redirect http://127.0.0.1:8080/oauth/callback (Port = WEB_PORT), Berechtigung „SMTP.Send“,
#   SMTP-AUTH für das Postfach erlaubt.
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# Nur Microsoft 365: Mandanten-ID oder common
MAIL_TENANT=common
# Postfach, von dem gesendet wird
MAIL_USER=

# ---------------------------------------------------------------------------
# Nicht in dieser Datei, sondern als Umgebungsvariable des Prozesses:
#   SIPFUNK_DATA_DIR  Datenordner (.env, settings.json, Protokolle); Standard: Projektordner bzw. %APPDATA%\SIPFunk
#   SIPFUNK_URL       nur für den MCP-Server: Adresse der Web-UI, falls nicht http://127.0.0.1:8080
# ---------------------------------------------------------------------------
