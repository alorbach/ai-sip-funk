{
  "name": "sipfunk",
  "version": "0.1.0",
  "description": "Local AI phone assistant: SIP client for a FRITZ!Box using the OpenAI Realtime API (outgoing calls, answering machine, spam defence)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test-call": "tsx src/tools/test-call.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "mcp": "tsx src/mcp/server.ts",
    "sim": "tsx src/sim/simulate.ts",
    "build": "tsc -p tsconfig.build.json",
    "icons": "node scripts/generate-icons.mjs",
    "tray": "npm run build && electron .",
    "dist:win": "npm run build && npm run icons && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nodemailer": "^7.0.13",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.sipfunk.app",
    "productName": "SIPFunk",
    "artifactName": "SIPFunk-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "personas/**/*",
      "electron/**/*",
      "assets/icon.*",
      ".env.example",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
