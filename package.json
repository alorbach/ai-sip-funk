{
  "name": "sipfunk",
  "version": "1.0.5",
  "description": "Local AI phone assistant: SIP client for a FRITZ!Box using the OpenAI Realtime API or the Google Gemini Live API (outgoing calls, answering machine, spam defence)",
  "keywords": [
    "ai",
    "voice-assistant",
    "phone",
    "sip",
    "voip",
    "fritzbox",
    "openai",
    "realtime-api",
    "gemini",
    "gemini-live-api",
    "answering-machine",
    "spam-call-blocker",
    "electron",
    "typescript",
    "windows"
  ],
  "homepage": "https://github.com/alorbach/ai-sip-funk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alorbach/ai-sip-funk.git"
  },
  "bugs": {
    "url": "https://github.com/alorbach/ai-sip-funk/issues"
  },
  "author": "Andre Lorbach",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test-call": "tsx src/tools/test-call.ts",
    "fax:bundle": "C:/msys64/usr/bin/bash.exe tools/faxmodem/bundle.sh",
    "fax-poc": "tsx src/tools/fax-poc.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "mcp": "tsx src/mcp/server.ts",
    "sim": "tsx src/sim/simulate.ts",
    "build": "tsc -p tsconfig.build.json",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "npm run build && electron scripts/capture-screenshots.cjs",
    "screenshots:store": "npm run build && electron scripts/capture-screenshots.cjs --store",
    "tray": "npm run build && electron .",
    "dist:win": "npm run build && npm run icons && electron-builder --win --publish never",
    "dist:store": "npm run build && npm run icons && electron-builder --win appx --publish never",
    "install:local": "node scripts/install-local.mjs",
    "install:auto": "node scripts/install-local.mjs --setup"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nodemailer": "^7.0.13",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.sipfunk.app",
    "productName": "SIPFunk",
    "artifactName": "SIPFunk-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "vendor/fax",
        "to": "fax"
      },
      {
        "from": "scripts/fax-printer.ps1",
        "to": "fax/fax-printer.ps1"
      }
    ],
    "files": [
      "dist/**/*",
      "public/**/*",
      "personas/**/*",
      "electron/**/*",
      "assets/icon.*",
      ".env.example",
      "oauth-clients.json",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "appx": {
      "customManifestPath": "appxmanifest.xml",
      "artifactName": "SIPFunk-${version}-store-${arch}.${ext}",
      "identityName": "delta2win.SIPFunk",
      "publisher": "CN=A24BF929-59B8-4B7C-9D56-1BE02925DEE0",
      "publisherDisplayName": "delta2win",
      "applicationId": "SIPFunk",
      "displayName": "SIPFunk",
      "languages": [
        "de-DE",
        "en-US"
      ],
      "capabilities": [
        "microphone",
        "unvirtualizedResources"
      ],
      "addAutoLaunchExtension": true,
      "backgroundColor": "transparent",
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0"
    }
  }
}
