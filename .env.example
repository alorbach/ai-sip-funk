# SIPFunk – example configuration (Deutsch: .env.example.de)
#
# Copy to .env and fill in the values. The .env holds credentials: never commit it, never share it.
# Only SIP_USER and SIP_PASSWORD are required; AI calls additionally need OPENAI_API_KEY.
# Changes take effect after a restart.
#
# Many values are only INITIAL VALUES: they can be changed in the web UI and are then stored in settings.json,
# which takes precedence over this file. Such variables are marked [UI].
# Write switches as shown in each example (true/false or on/off); 1 and ja count as "on" everywhere.
# Free-text values (names, tasks, notes) are passed to the AI, which speaks German: write them in German.

# ---------------------------------------------------------------------------
# Phone system (FRITZ!Box: Telefonie → Telefoniegeräte → LAN/WLAN (IP-Telefon))
# ---------------------------------------------------------------------------
# Address of the box; also used as the SIP domain
SIP_SERVER=fritz.box
# User name and password of the IP phone extension
SIP_USER=
SIP_PASSWORD=
# Local UDP port for SIP (not 5060, to avoid conflicts with other softphones)
SIP_LOCAL_PORT=5062
# Local UDP port for the audio (RTP)
RTP_PORT=40000
# Local IP address of this computer in the LAN, e.g. 192.0.2.20; empty = detect automatically
LOCAL_IP=
# HD audio: negotiate G.711 at 16 kHz; false = classic 8 kHz only (for cross-checking audio problems)
AUDIO_HD=true
# 1 = write all SIP messages to the log (contains phone numbers)
SIP_DEBUG=0

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# API key with access to the Realtime models; empty = test tone and echo only
OPENAI_API_KEY=
# [UI] Speech model (Realtime): gpt-realtime-2.1 or gpt-realtime-2.1-mini
OPENAI_MODEL=gpt-realtime-2.1
# [UI] Text model for call plan, summary, assessment and complaint draft
OPENAI_SUMMARY_MODEL=gpt-6-luna

# ---------------------------------------------------------------------------
# Operation
# ---------------------------------------------------------------------------
# Port of the web UI (bound to 127.0.0.1 only)
WEB_PORT=8080
# Listening in via the browser (live only, no recording)
LIVE_LISTEN_ENABLED=true
# Your own phone number(s), comma-separated, e.g. 0171 3920000. Target of the call back for important calls;
# there the AI greets you personally without the AI explanation. Alternative: a contact flagged "Inhaber" (owner).
OWNER_NUMBERS=
# [UI] Hard call time limit in seconds
MAX_CALL_SECONDS=300
# [UI] Delete call logs after this many days
TRANSCRIPT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# AI assistant and call form [UI]
# ---------------------------------------------------------------------------
# Name the AI introduces itself with
AI_NAME=Alex
# On whose behalf it speaks (your name or your company's), e.g. Max Mustermann
AI_PRINCIPAL=
# Style: file name from personas/ without number and extension (professionell, locker, formell, herzlich)
AI_PERSONA=professionell
# Voice: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
AI_VOICE=marin
# Form of address: sie (formal) or du (informal)
AI_ADDRESS=sie
# Additional behaviour notes (free text)
AI_EXTRA=
# Pre-filled task for outgoing calls
AI_TASK=
# Pre-selected audio mode: ai (AI call), tone (test tone) or echo
AI_DEFAULT_MODE=ai

# ---------------------------------------------------------------------------
# Conversation behaviour [UI: Einstellungen › Technik]
# ---------------------------------------------------------------------------
# Speaking rate of the AI (0.25–1.5, 1 = normal)
AI_SPEECH_SPEED=1.05
# Gain of the AI voice towards the phone (1 = unchanged)
AI_OUTPUT_GAIN=1.5
# May the other party interrupt the AI?
AI_ALLOW_INTERRUPT=true
# Silence in ms after which the end of a turn is assumed (higher = less talking into thinking pauses)
AI_VAD_SILENCE_MS=900
# Voice detection threshold (0.3–0.9): higher = noises interrupt the AI less often
AI_VAD_THRESHOLD=0.6
# Outgoing: how long in ms to wait for the other party before the AI greets by itself
AI_GREETING_WAIT_MS=2500
# Listening phase in ms after the goodbye: if the other party says something more, the call continues
AI_HANGUP_GRACE_MS=2000
# Stall watchdog: if it stays silent this long (ms) after the AI's output, the AI is nudged (0 = off)
AI_STALL_MS=6000

# ---------------------------------------------------------------------------
# Answering machine [UI]
# ---------------------------------------------------------------------------
# Let the AI answer incoming calls
INCOMING_ENABLED=off
# Answer on the n-th ring (1 = immediately)
INCOMING_ANSWER_AFTER_RINGS=5
# Task for incoming calls; empty = take down the request and call-back wish
INCOMING_TASK=
# Deprecated, only still imported: announcement per own number as "last digits = name", several separated by ;
# e.g. 23125100 = Max Mustermann; 23125200 = Mustermann IT-Service. Better: create profiles in the web UI.
INCOMING_IDENTITIES=

# ---------------------------------------------------------------------------
# Notifications after an answered call [UI]
# ---------------------------------------------------------------------------
# Tray notification (tray app only)
NOTIFY_TRAY=on
# E-mail with summary (needs the e-mail settings below)
NOTIFY_EMAIL=on
# Call the owner for important calls (needs OWNER_NUMBERS or an owner contact)
NOTIFY_CALL=on
# Pop-up of the tray app while a call is ringing
RING_POPUP=on

# ---------------------------------------------------------------------------
# Spam defence [UI]
# ---------------------------------------------------------------------------
# The mode itself can ONLY be switched on in the web UI, after confirming the risk (doc/legal.md).
# Known spam numbers or prefixes, separated by ; – "anonym" = withheld numbers
SCAM_NUMBERS=
# Look up unknown caller numbers at tellows.de while ringing; sends the number there
SPAM_LOOKUP=off

# ---------------------------------------------------------------------------
# E-mail [UI: Einstellungen › E-Mail-Versand, which also offers "Automatisch einrichten"]
# ---------------------------------------------------------------------------
# Delivery method: smtp (password) | gmail (OAuth) | m365 (Microsoft 365, OAuth)
MAIL_PROVIDER=smtp
# Recipient of the notifications, e.g. max@example.com; empty = the mailbox itself
NOTIFY_EMAIL_TO=
# Sender; empty = the mailbox
MAIL_FROM=

# --- smtp ---
# Server, e.g. smtp.example.com; empty = no mail
SMTP_HOST=
SMTP_PORT=587
# true = SSL/TLS (usually port 465), false = STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=
# With many providers an app password, not the account password
SMTP_PASS=

# --- gmail / m365 ---
# OAuth client; sign-in happens once via "Mail-Konto verbinden" in the web UI.
# Gmail: Google Cloud Console → OAuth client of type "Desktop app".
# Microsoft 365: Entra app registration, platform "Mobile and desktop applications",
#   redirect http://127.0.0.1:8080/oauth/callback (port = WEB_PORT), permission "SMTP.Send",
#   SMTP AUTH enabled for the mailbox.
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# Microsoft 365 only: tenant ID or common
MAIL_TENANT=common
# Mailbox to send from
MAIL_USER=

# ---------------------------------------------------------------------------
# Not in this file but as environment variables of the process:
#   SIPFUNK_DATA_DIR  data folder (.env, settings.json, logs); default: project folder or %APPDATA%\SIPFunk
#   SIPFUNK_URL       MCP server only: address of the web UI if not http://127.0.0.1:8080
# ---------------------------------------------------------------------------
